---
import type { DocsChromeConfig } from '@kolektiv/common-docs-chrome';

interface Props {
  config: DocsChromeConfig;
}

const { config } = Astro.props;
const frameworks = config.frameworks ?? [];
const defaultFramework = config.defaultFramework ?? frameworks[0]?.id;
const id = 'kdc-framework-pop';
const anchor = '--kdc-framework';
const current = frameworks.find((framework) => framework.id === defaultFramework);
---

{
  frameworks.length > 0 && (
    <>
      <button
        type="button"
        class="btn btn-ghost btn-sm min-h-11 gap-2 px-3"
        popovertarget={id}
        style={`anchor-name:${anchor}`}
        data-kdc-toggle="framework"
        aria-label="Framework"
        title="Framework"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h10" stroke-linecap="round"></path>
        </svg>
        <span data-framework-current class="hidden sm:inline">
          {current?.label ?? defaultFramework}
        </span>
      </button>
      <div
        popover
        id={id}
        role="dialog"
        aria-label="Choose framework"
        class="dropdown dropdown-end dropdown-bottom w-60 rounded-box border-2 border-base-300 bg-base-100 p-3 shadow-lg"
        style={`position-anchor:${anchor}`}
      >
        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-2 font-mono text-xs uppercase tracking-widest text-base-content/60">
            Framework
          </legend>
          <ul class="menu menu-sm w-full gap-0.5 p-0">
            {frameworks.map((framework) => (
              <li>
                <label class="flex cursor-pointer items-center gap-2">
                  <input
                    type="radio"
                    class="radio radio-xs radio-primary"
                    name="kdc-framework"
                    data-pref="framework"
                    data-label={framework.label}
                    value={framework.id}
                    checked={framework.id === defaultFramework}
                  />
                  <span>{framework.label}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      </div>
    </>
  )
}
