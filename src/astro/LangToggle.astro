---
import Switcher from './Switcher.astro';
import { resolveSwitchers, type DocsChromeConfig } from '@kolektiv/common-docs-chrome';

interface Props {
  config: DocsChromeConfig;
  size?: 'xs' | 'sm';
}

const { config, size } = Astro.props;
const lang = resolveSwitchers(config).find((switcher) => switcher.id === 'lang');
---

{lang && <Switcher config={config} switcher={lang} size={size} />}
