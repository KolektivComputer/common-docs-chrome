---
import BaseHead from './BaseHead.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import Sidebar from './Sidebar.astro';
import SearchDialog from './SearchDialog.astro';
import Mark from './Mark.astro';
import {
  pageLabelFor,
  path,
  resolveSwitchers,
  toggleRelevanceScript,
  type DocsChromeConfig,
  type NavbarConfig,
  type TocHeading,
} from '@kolektiv/common-docs-chrome';

interface Props {
  config: DocsChromeConfig;
  title: string;
  description?: string;
  currentPath?: string;
  pageLabel?: string;
  /** Per-page navbar override, merged over `config.navbar`. */
  navbar?: Partial<NavbarConfig>;
  /** Astro Markdown headings, or hand-authored h2/h3 entries for `.astro` pages. */
  headings?: TocHeading[];
  /** Auto ToC on by default; `false` opts a page out. */
  toc?: boolean;
}

const { config, navbar } = Astro.props;
const currentPath = Astro.props.currentPath ?? Astro.url.pathname;
const label = Astro.props.pageLabel ?? pageLabelFor(config, currentPath);
const defaultLang = config.defaultLang ?? config.langs?.[0]?.id;
const defaultFramework = config.defaultFramework ?? config.frameworks?.[0]?.id;
const switcherAttrs = Object.fromEntries(
  resolveSwitchers(config)
    .filter((switcher) => switcher.id !== 'lang' && switcher.id !== 'framework')
    .map((switcher) => [
      `data-${switcher.id}`,
      switcher.default ?? switcher.options[0]?.id ?? '',
    ]),
);
const drawerId = 'kdc-drawer';
const headings = (Astro.props.headings ?? []).filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug && heading.text,
);
const showToc = Astro.props.toc !== false && headings.length > 0;
---

<!doctype html>
<html
  lang="en"
  data-theme={config.defaultTheme}
  data-code-theme={config.defaultCodeTheme ?? 'follow'}
  data-lang={defaultLang}
  data-framework={defaultFramework}
  {...switcherAttrs}
  class="antialiased"
>
  <head>
    <BaseHead
      config={config}
      title={Astro.props.title}
      description={Astro.props.description}
    />
  </head>
  <body class="min-h-dvh bg-base-100 font-sans text-base-content">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 btn btn-sm"
    >
      Skip to content
    </a>

    <div class="drawer lg:drawer-open">
      <input id={drawerId} type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex min-h-dvh flex-col">
        <Navbar
          config={config}
          currentPath={currentPath}
          pageLabel={label}
          drawerId={drawerId}
          hideBrandOnDesktop
          navbar={navbar}
          slotFilled={{
            brand: Astro.slots.has('brand'),
            'navbar-start': Astro.slots.has('navbar-start'),
            'navbar-center': Astro.slots.has('navbar-center'),
            'navbar-end': Astro.slots.has('navbar-end'),
          }}
        >
          <slot name="brand" slot="brand" />
          <slot name="navbar-start" slot="navbar-start" />
          <slot name="navbar-center" slot="navbar-center" />
          <slot name="navbar-end" slot="navbar-end" />
        </Navbar>
        <main id="main" class="flex-1 px-4 py-8 sm:px-8 lg:px-10">
          <div
            class:list={[
              'mx-auto w-full',
              showToc ? 'flex max-w-5xl items-start gap-8' : 'max-w-3xl',
            ]}
          >
            <div class="min-w-0 flex-1">
              {
                showToc && (
                  <details class="kdc-toc-mobile not-prose mb-8 rounded-box border border-base-300 bg-base-200/60 px-4 py-3 lg:hidden">
                    <summary class="cursor-pointer text-sm font-medium">On this page</summary>
                    <nav aria-label="On this page" class="mt-3">
                      <ul class="kdc-toc-list">
                        {headings.map((heading) => (
                          <li class:list={[heading.depth === 3 && 'is-h3']}>
                            <a href={`#${heading.slug}`} data-kdc-toc-link={heading.slug}>
                              {heading.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                  </details>
                )
              }
              <article class="kdc-prose mx-auto max-w-3xl">
                <slot />
              </article>
            </div>
            {
              showToc && (
                <aside class="hidden w-52 shrink-0 lg:block">
                  <div class="lg:sticky lg:top-24 lg:max-h-[calc(100dvh-8rem)] lg:overflow-y-auto">
                    <p class="kdc-toc-title">On this page</p>
                    <nav aria-label="On this page">
                      <ul class="kdc-toc-list">
                        {headings.map((heading) => (
                          <li class:list={[heading.depth === 3 && 'is-h3']}>
                            <a href={`#${heading.slug}`} data-kdc-toc-link={heading.slug}>
                              {heading.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                  </div>
                </aside>
              )
            }
          </div>
        </main>
        <Footer config={config} />
      </div>

      <div class="drawer-side z-40">
        <label for={drawerId} class="drawer-overlay" aria-label="Close docs menu"></label>
        <aside class="flex h-dvh w-72 flex-col overflow-hidden bg-base-200">
          <a
            href={path('/', config.base)}
            class="flex items-stretch gap-3 border-b border-base-300 px-5 py-5"
          >
            <span class="aspect-square self-stretch">
              <Mark config={config} class="size-14" />
            </span>
            <span class="flex min-w-0 flex-col justify-center">
              <span class="font-display text-2xl leading-none tracking-tight">
                {config.name}
              </span>
              <span
                class="mt-1 font-mono text-[0.65rem] font-medium uppercase tracking-[0.18em] text-base-content/70"
              >
                Documentation
              </span>
            </span>
          </a>
          <div class="border-b border-base-300 px-3 py-3">
            <SearchDialog config={config} />
          </div>
          <div class="min-h-0 flex-1 overflow-y-auto">
            <Sidebar config={config} currentPath={currentPath} />
          </div>
        </aside>
      </div>
    </div>
    <script is:inline set:html={toggleRelevanceScript} />
    <script>
      const links = [
        ...document.querySelectorAll<HTMLAnchorElement>('[data-kdc-toc-link]'),
      ];
      if (links.length > 0) {
        const bySlug = new Map<string, HTMLAnchorElement[]>();
        for (const link of links) {
          const slug = link.dataset.kdcTocLink ?? '';
          const list = bySlug.get(slug) ?? [];
          list.push(link);
          bySlug.set(slug, list);
        }

        const targets = [...bySlug.keys()]
          .map((slug) => document.getElementById(slug))
          .filter((element): element is HTMLElement => element !== null);

        let activeSlug = '';
        const setActive = (slug: string) => {
          if (slug === activeSlug) return;
          activeSlug = slug;
          for (const link of links) link.removeAttribute('aria-current');
          for (const link of bySlug.get(slug) ?? []) {
            link.setAttribute('aria-current', 'location');
          }
        };

        const update = () => {
          const threshold = 96;
          let current = targets[0]?.id ?? '';
          for (const target of targets) {
            if (target.getBoundingClientRect().top <= threshold) current = target.id;
            else break;
          }
          setActive(current);
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            update();
          });
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
