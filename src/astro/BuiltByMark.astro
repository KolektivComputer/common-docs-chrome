---
import { renderBrandVariant } from '@kolektiv/brand-core';
import type { DocsChromeConfig } from '@kolektiv/common-docs-chrome';

interface Props {
  config?: DocsChromeConfig;
  class?: string;
  markClass?: string;
}

const { config, class: className = '', markClass = 'h-10 w-auto' } = Astro.props;
const builtBy = config?.builtBy ?? {};
const href = builtBy.href ?? 'https://kolektiv.computer';
const label = builtBy.label ?? 'Built by Kolektiv Computing';
const external = /^[a-z][a-z0-9+.-]*:/i.test(href);
// The legacy `renderBrandMark` variant map left the icon mark (the initial K)
// out of `builtByMark`, so render the generated per-variant content instead.
const mark = renderBrandVariant('builtByMark', {
  title: label,
  color: 'currentColor',
  className: markClass,
});
---

<a
  href={href}
  class:list={['inline-flex items-center gap-2 text-current', className]}
  rel={external ? 'noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  aria-label={label}
>
  {
    builtBy.mark ? (
      <img src={builtBy.mark} alt="" class:list={['shrink-0', markClass]} />
    ) : (
      <Fragment set:html={mark} />
    )
  }
</a>
